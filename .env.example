# Public site URL (canonical links, Open Graph, sitemap). Production: https://uprightconceptsmedia.com
VITE_SITE_URL=http://localhost:3000

# Optional: Google Search Console HTML-tag verification code (content="..." value only)
VITE_GOOGLE_SITE_VERIFICATION=

# Show TanStack Router/Query devtools in development
VITE_DEVTOOLS=false

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Supabase dashboard > Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=

# Cloudinary (API key/secret are server-only)
VITE_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
